# SpaceXAI / xAI (agents — optional)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5

# Google Gemini (Mem0 LLM + embeddings)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=models/gemini-embedding-001

ALLOW_OFFLINE_AGENTS=1
AGENT_FORCE_OFFLINE=1
AGENT_TEMPERATURE=0.2

# Memory / Mem0
MEM0_ENABLED=1
MEM0_USE_REMOTE=1
MEM0_PROVIDER=gemini
MEM0_DATA_DIR=.mem0
MEMORY_USER_ID=crm_company
MEMORY_TOP_K=5

# Linear (push backlog)
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# ---- Database (1) Postgres + Alembic ----
# Default: sqlite:///.data/pos.db
# Staging:
#   docker compose up -d postgres
#   DATABASE_URL=postgresql+psycopg://crm:crm@127.0.0.1:5432/crm_pos
#   USE_ALEMBIC=1
DATABASE_URL=
USE_ALEMBIC=0
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---- Redis + Celery (2) ----
#   docker compose up -d redis
#   CELERY_ENABLED=1
#   uv run celery -A workers.celery_app.celery_app worker -l info -B
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_ENABLED=0
CELERY_ON_PUBLISH=1
CELERY_OUTBOX_INTERVAL=15
OUTBOX_WORKER=1
OUTBOX_WORKER_INTERVAL=15
OUTBOX_MAX_ATTEMPTS=5

# ---- VNPay sandbox (3) ----
