# SpaceXAI / xAI (agents — optional)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.5

# Google Gemini (Mem0 LLM + embeddings)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=models/gemini-embedding-001

ALLOW_OFFLINE_AGENTS=1
AGENT_FORCE_OFFLINE=1
AGENT_TEMPERATURE=0.2

# Memory / Mem0
MEM0_ENABLED=1
MEM0_USE_REMOTE=1
MEM0_PROVIDER=gemini
MEM0_DATA_DIR=.mem0
MEMORY_USER_ID=crm_company
MEMORY_TOP_K=5

# Linear (push backlog)
LINEAR_API_KEY=
LINEAR_TEAM_ID=

